<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.shopping3.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.example.shopping3.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="name" property="name"/>
        <result column="phone" property="phone"/>
        <result column="role" property="role"/>
        <result column="avatar" property="avatar"/> <!-- 确保实体类有 avatar 字段 -->
    </resultMap>

    <!-- 根据用户名查询 -->
    <select id="selectByUserName" resultMap="UserResultMap">
        SELECT * FROM user WHERE username = #{username}
    </select>

    <!-- 新增用户 -->
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, name, phone, role, avatar)
        VALUES (#{username}, #{password}, #{name}, #{phone}, #{role}, #{avatar})
    </insert>

    <!-- 【新增】根据ID查询 -->
    <select id="selectById" resultMap="UserResultMap">
        SELECT * FROM user WHERE id = #{id}
    </select>

    <!-- 【新增】动态更新用户 -->
    <update id="updateUser">
        UPDATE user
        <set>
            <!-- 只有当字段不为 null 时才更新 -->
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="role != null">role = #{role},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>