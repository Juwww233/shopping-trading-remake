<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.shopping3.mapper.CommentMapper">

    <resultMap id="CommentResultMap" type="Comment">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="goods_id" property="goodsId"/>
        <result column="content" property="content"/>
        <result column="time" property="time"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comment (user_id, goods_id, content, time)
        VALUES (#{userId}, #{goodsId}, #{content}, #{time})
    </insert>

    <select id="selectByGoodsId" resultMap="CommentResultMap">
        SELECT * FROM comment WHERE goods_id = #{goodsId} ORDER BY id DESC
    </select>

    <delete id="delete">
        DELETE FROM comment WHERE id = #{id}
    </delete>

</mapper>
